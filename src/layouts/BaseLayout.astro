---
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang={Astro.currentLocale || 'es'} style="background-color: #e8f0ec;">
  <head>
    <script is:inline>
      (function() {
        var s = localStorage.getItem('theme-set-at');
        var t = localStorage.getItem('theme');
        if (s && Date.now() - Number(s) > 43200000) {
          localStorage.removeItem('theme');
          localStorage.removeItem('theme-set-at');
          t = null;
        }
        var d = t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (d) {
          document.documentElement.classList.add('dark');
          document.documentElement.style.backgroundColor = '#141f1a';
        }
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Guía interactiva de disciplina positiva para padres" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <title>{title} | Disciplina Positiva</title>
  </head>
  <body class="bg-surface font-body text-text min-h-screen">
    <slot />
    <script>
      document.querySelectorAll('a[href^="http"]').forEach(link => {
        link.setAttribute('target', '_blank');
        link.setAttribute('rel', 'noopener noreferrer');
      });
    </script>
  </body>
</html>
