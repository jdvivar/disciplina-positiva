---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang={Astro.currentLocale || 'es'} style="background-color: #e8f0ec;">
  <head>
    <script is:inline>
      (function() {
        var s = localStorage.getItem('theme-set-at');
        var t = localStorage.getItem('theme');
        if (s && Date.now() - Number(s) > 43200000) {
          localStorage.removeItem('theme');
          localStorage.removeItem('theme-set-at');
          t = null;
        }
        var d = t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (d) {
          document.documentElement.classList.add('dark');
          document.documentElement.style.backgroundColor = '#141f1a';
        }
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Aprende a criar con respeto, calidez y sin violencia. Guía interactiva basada en el manual de la Dra. Joan E. Durrant." />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | Disciplina Positiva`} />
    <meta property="og:description" content="Aprende a criar con respeto, calidez y sin violencia. Guía interactiva basada en el manual de la Dra. Joan E. Durrant." />
    <meta property="og:image" content="https://disciplina-positiva.danielvivar.com/og-image.png" />
    <meta property="og:url" content="https://disciplina-positiva.danielvivar.com" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Disciplina Positiva" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Disciplina Positiva`} />
    <meta name="twitter:description" content="Aprende a criar con respeto, calidez y sin violencia. Guía interactiva basada en el manual de la Dra. Joan E. Durrant." />
    <meta name="twitter:image" content="https://disciplina-positiva.danielvivar.com/og-image.png" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <title>{title} | Disciplina Positiva</title>
  </head>
  <body class="bg-surface font-body text-text min-h-[100svh]">
    <slot />
    <Analytics />
    <script>
      document.querySelectorAll('a[href^="http"]').forEach(link => {
        link.setAttribute('target', '_blank');
        link.setAttribute('rel', 'noopener noreferrer');
      });
    </script>
  </body>
</html>
