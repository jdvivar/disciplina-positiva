---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Inicio">
  <div class="cover-page min-h-[100svh] bg-sage-900 flex items-center justify-center px-6 py-12">
    <div class="w-full max-w-2xl flex items-center gap-8">
      <!-- Left: Text content -->
      <div class="flex-1">
        <p class="font-body text-xs uppercase tracking-widest text-sage-200 mb-4">
          Guía interactiva para familias
        </p>
        <h1 class="font-heading text-4xl font-bold text-sage-100 leading-tight mb-4">
          Disciplina<br>Positiva
        </h1>
        <p class="font-body text-base text-sage-200 max-w-[340px] leading-relaxed mb-9">
          Aprende a criar con respeto, calidez y sin violencia. A tu propio ritmo.
        </p>
        <a
          href="/es/intro"
          data-astro-reload
          class="inline-flex items-center gap-2.5 bg-sage-600 text-white font-body text-base font-medium px-9 py-3.5 rounded-xl border-2 border-transparent transition-all duration-300 hover:border-sage-200 hover:shadow-[0_0_20px_rgba(183,228,199,0.3)]"
        >
          Comenzar
          <svg class="w-4.5 h-4.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg>
        </a>
        <p class="font-body text-xs text-sage-500 mt-7">
          Basado en el manual de la Dra. Joan E. Durrant<br>
          Save the Children / ACHNU Chile
        </p>
      </div>

      <!-- Right: Icon -->
      <div class="flex-shrink-0 hidden md:block">
        <div class="w-40 h-40 bg-sage-600/15 rounded-[36px] flex items-center justify-center">
          <svg width="100" height="100" viewBox="6 10 68 60" fill="none">
            <path d="M12 56C12 56 18 46 28 42C34 40 38 39 42 39C46 39 52 40 58 44C62 47 64 52 62 56C58 62 48 64 40 64C30 64 20 62 12 56Z" fill="#52796f"/>
            <path d="M40 39V14" stroke="#40916c" stroke-width="4" stroke-linecap="round"/>
            <path d="M40 28C34 22 24 19 21 22C18 25 22 34 30 34C35 34 38 31 40 28Z" fill="#40916c"/>
            <path d="M40 20C46 14 56 11 59 14C62 17 58 26 50 26C45 26 42 23 40 20Z" fill="#b7e4c7"/>
          </svg>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
