---
import { getCollection } from 'astro:content';
import type { ChapterMeta } from '../../lib/types';
import { extractExercisesFromRaw } from '../../lib/extract-exercises';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppShell from '../../components/AppShell.svelte';
import Journal from '../../components/Journal.svelte';
import ChapterContent from '../../components/ChapterContent.svelte';
import '../../styles/print.css';

export async function getStaticPaths() {
  return [{ params: { lang: 'es' } }];
}

const allChapters = await getCollection('es');

// Sort chapters by order
const sorted = [...allChapters].sort((a, b) => a.data.order - b.data.order);

// Extract exercises from raw MDX source (shared with [...slug].astro)

// Build ChapterMeta[] for all chapters
const chaptersMeta: ChapterMeta[] = sorted.map((ch) => ({
  title: ch.data.title,
  chapter: ch.data.chapter,
  order: ch.data.order,
  slug: ch.id,
  exercises: extractExercisesFromRaw(ch.body ?? ''),
}));
---

<BaseLayout title="Mi Diario de Crianza">
  <AppShell chapters={chaptersMeta} currentSlug="diario" client:load>
    <Journal chapters={chaptersMeta} client:load />
    <ChapterContent
      chapter={{ title: 'Mi Diario de Crianza', slug: 'diario', order: 998, exercises: [] }}
      prevChapter={chaptersMeta.find(c => c.slug === 'conclusion') ?? null}
      nextChapter={chaptersMeta.find(c => c.slug === 'about') ?? null}
      client:load
    />
  </AppShell>
</BaseLayout>
