---
import { getCollection } from 'astro:content';
import type { PageMeta } from '../../lib/types';
import { extractExercisesFromRaw } from '../../lib/extract-exercises';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppShell from '../../components/AppShell.svelte';
import Journal from '../../components/Journal.svelte';
import ChapterContent from '../../components/ChapterContent.svelte';
import '../../styles/print.css';

export async function getStaticPaths() {
  return [{ params: { lang: 'es' } }];
}

const allEntries = await getCollection('es');

const sorted = [...allEntries].sort((a, b) => a.data.order - b.data.order);

const pagesMeta: PageMeta[] = sorted.map((e) => {
  const hasSlash = e.id.includes('/');
  return {
    title: e.data.title,
    chapter: e.data.chapter,
    order: e.data.order,
    slug: e.id,
    exercises: extractExercisesFromRaw(e.body ?? ''),
    parentSlug: hasSlash ? e.id.split('/')[0] : undefined,
    isIndex: !hasSlash,
  };
});
---

<BaseLayout title="Mi Diario de Crianza">
  <AppShell pages={pagesMeta} currentSlug="diario" client:load>
    <Journal chapters={pagesMeta} client:load />
    <ChapterContent
      page={{ title: 'Mi Diario de Crianza', slug: 'diario', order: 998, exercises: [], isIndex: true }}
      prevPage={pagesMeta.find(p => p.slug === 'conclusion') ?? null}
      nextPage={pagesMeta.find(p => p.slug === 'about') ?? null}
      client:load
    />
  </AppShell>
</BaseLayout>
