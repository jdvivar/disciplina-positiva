---
import { getCollection, render } from 'astro:content';
import type { PageMeta } from '../../lib/types';
import { extractExercisesFromRaw } from '../../lib/extract-exercises';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppShell from '../../components/AppShell.svelte';
import ChapterContent from '../../components/ChapterContent.svelte';

export async function getStaticPaths() {
  const entries = await getCollection('es');
  return entries.map((entry) => ({
    params: { lang: 'es', slug: entry.id },
  }));
}

const { slug } = Astro.params;
const allEntries = await getCollection('es');

const sorted = [...allEntries].sort((a, b) => a.data.order - b.data.order);

const currentEntry = sorted.find((e) => e.id === slug);
if (!currentEntry) {
  return Astro.redirect('/es/intro');
}

const pagesMeta: PageMeta[] = sorted.map((e) => {
  const hasSlash = e.id.includes('/');
  return {
    title: e.data.title,
    chapter: e.data.chapter,
    order: e.data.order,
    slug: e.id,
    exercises: extractExercisesFromRaw(e.body ?? ''),
    parentSlug: hasSlash ? e.id.split('/')[0] : undefined,
    isIndex: !hasSlash,
  };
});

const currentIdx = sorted.findIndex((e) => e.id === slug);
const currentMeta = pagesMeta[currentIdx];
const prevMeta = currentIdx > 0 ? pagesMeta[currentIdx - 1] : null;

const isConclusion = currentMeta.slug === 'conclusion';
const isAbout = currentMeta.slug === 'about';
const nextMeta = isConclusion
  ? { title: 'Mi Diario de Crianza', slug: 'diario', order: 998, exercises: [], isIndex: true } as PageMeta
  : isAbout
    ? null
    : currentIdx < pagesMeta.length - 1 ? pagesMeta[currentIdx + 1] : null;

const { Content } = await render(currentEntry);
const exercisesJson = JSON.stringify(currentMeta.exercises);
---

<BaseLayout title={currentEntry.data.title}>
  <AppShell pages={pagesMeta} currentSlug={slug!} client:load>
    <div class="chapter-page" data-exercises={exercisesJson} data-chapter-number={currentMeta.chapter ?? 0}>
      <article class="prose prose-sage max-w-none">
        <Content />
      </article>

      <ChapterContent
        page={currentMeta}
        prevPage={prevMeta}
        nextPage={nextMeta}
        client:load
      />
    </div>
  </AppShell>
</BaseLayout>

<script>
  import { hydrateExercises } from '../../lib/hydrate-exercises';
  import { migrateChapterProgress } from '../../lib/progress';

  migrateChapterProgress();

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', hydrateExercises);
  } else {
    hydrateExercises();
  }
</script>
